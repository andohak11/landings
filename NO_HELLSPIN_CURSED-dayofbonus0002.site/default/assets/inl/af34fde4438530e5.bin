      body {
        background: #05071a;
      }
      #load_content {
        position: fixed;
        top: 0;
        left:0;
        height: 100%;
        width: 100%;
      }
      #app-loader {
        position: fixed;
        top: 50%;
        left: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        transform: translate(-50%, -50%);
      }
      #app-loader img {
        display: block;
        width: 190px;
      }
      .loader-progress {
        height: 3px;
        width: 100%;
        --c:no-repeat linear-gradient(#fcc211 0 0);
        background: var(--c),var(--c), #05071a;
        background-size: 60% 100%;
        animation: l16 4s infinite;
        position: fixed;
        top: 0;
        left: 0;
      }
      @keyframes l16 {
        0%   {background-position:-150% 0,-150% 0}
        66%  {background-position: 250% 0,-150% 0}
        100% {background-position: 250% 0, 250% 0}
      }
